---
import Base from "../layouts/Base.astro";
import { site, serviceNav, areaImages } from "../data/site.js";
import { serviceNode, breadcrumb, faqNode } from "../lib/schema.js";
const { area } = Astro.props;
const path = `/${area.slug}/`;
const heroImg = area.img || areaImages[area.slug] || "/images/hero.jpg";
const schema = [
  serviceNode({ name: `Fire Damage Restoration in ${area.city}`, serviceType: "Fire damage restoration", description: area.metaDesc, path, cities: [area.city] }),
  breadcrumb([
    { name: "Home", path: "/" },
    { name: "Service Areas", path: "/service-areas/" },
    { name: area.city, path },
  ]),
];
if (area.faqs && area.faqs.length) schema.push(faqNode(area.faqs));
---
<Base title={area.metaTitle} description={area.metaDesc} path={path}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(schema)} />

  <div class="wrap"><div class="crumbs"><a href="/">Home</a> / <a href="/service-areas/">Service Areas</a> / {area.city}</div></div>

  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <span class="kicker"><svg style="width:16px;height:16px;vertical-align:-3px"><use href="#i-pin"/></svg> {area.city}, {site.region}</span>
        <h1>Fire Damage Restoration in {area.city}, {site.region}</h1>
        <p class="lead">{area.lead}</p>
        <div class="hero-cta">
          <a class="btn btn-call" href={site.phoneHref}><svg><use href="#i-phone"/></svg> Call {site.phone}</a>
          <span class="tapline">Upfront pricing · No obligation · {site.hoursShort}</span>
        </div>
        <ul class="creds">
          <li><svg><use href="#i-pin"/></svg> Serving {area.city} & nearby</li>
          <li><svg><use href="#i-flame"/></svg> Fire, smoke & water damage</li>
          <li><svg><use href="#i-check"/></svg> Cleanup to full repairs</li>
        </ul>
      </div>
      <div class="hero-art">
        <img src={heroImg} width="800" height="600" alt={`Homes in ${area.city}, ${site.region} served by a local fire damage restoration crew`} />
      </div>
    </div>
  </section>

  <section>
    <div class="wrap prose">
      {area.intro.map((p) => <p set:html={p} />)}
    </div>
  </section>

  <section class="bg-paper">
    <div class="wrap prose">
      <h2>{area.localHead}</h2>
      {area.local.map((p) => <p set:html={p} />)}
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="section-head"><span class="kicker">What we handle in {area.city}</span><h2>Fire & Smoke Restoration Services</h2></div>
      <div class="svc-rows">
        {serviceNav.map((s) => (
          <a class="svc-row" href={`/${s.slug}/`}>
            <img src={s.img} width="118" height="82" alt={`${s.label} for ${area.city}, TX`} loading="lazy" />
            <span><h3>{s.label}</h3><span class="more">View service →</span></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-ink">
    <div class="wrap feature">
      <div>
        <span class="kicker">Why call a local restoration crew</span>
        <h2>{area.whyHead}</h2>
        {area.why.map((p) => <p set:html={p} />)}
      </div>
      <div class="panel">
        <h3>Fire Damage in {area.city}?</h3>
        <p>Call and describe what happened. A local fire damage restoration crew assesses the property, gives upfront pricing, and gets the cleanup and repairs moving. No obligation.</p>
        <a class="btn btn-call" href={site.phoneHref} style="width:100%;justify-content:center;margin-top:6px"><svg><use href="#i-phone"/></svg> Call {site.phone}</a>
      </div>
    </div>
  </section>

  {area.faqs && area.faqs.length > 0 && (
    <section class="bg-paper">
      <div class="wrap" style="max-width:820px">
        <div class="section-head center"><span class="kicker">FAQ</span><h2>{area.city} Fire Restoration Questions</h2></div>
        <div class="faq">
          {area.faqs.map((f, i) => (
            <details open={i === 0}><summary>{f.q}</summary><div class="ans"><p>{f.a}</p></div></details>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="callband">
    <div class="wrap">
      <h2>Fire &amp; Smoke Damage Help in {area.city}</h2>
      <div class="num"><a href={site.phoneHref}>{site.phone}</a></div>
      <p>{site.hoursShort} · {area.city}, TX · upfront pricing, no obligation</p>
      <div style="margin-top:18px"><a class="btn btn-ghost" href={site.phoneHref}><svg><use href="#i-phone"/></svg> Call Now</a></div>
    </div>
  </section>
</Base>
